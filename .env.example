# =====================================================================================================
# Optimize All — API configuration reference (environment-variable form).
#
# ASP.NET Core maps `Section__Key` env vars to `Section:Key` settings; array items use an index
# (`Database__Seed__0`). Any variable can instead be provided from a file by appending `_FILE`
# (e.g. `Jwt__SigningKey_FILE=/run/secrets/jwt_signing_key`) when running the API container image.
#
# Precedence (highest first): environment variables > appsettings.{Environment}.json > appsettings.json.
# Local development needs NONE of these: appsettings.Development.json has working defaults.
# Placeholders below are safe examples — generate real secrets with scripts/generate-secrets.sh --aspnet.
# Never commit a filled-in copy (.env and .env.* are git-ignored).
# =====================================================================================================

# ---------------------------------------------------------------- Hosting
# Development | Staging | Production. Production refuses non-SMTP email and hides Swagger by default.
ASPNETCORE_ENVIRONMENT=Production
# Listen address (the container image uses http://+:8080). TLS terminates at the reverse proxy.
ASPNETCORE_URLS=http://+:8080
# X-Forwarded-For/Proto are honoured ONLY from these proxies/networks (otherwise clients could spoof their IP
# to evade rate limits and pollute audit logs). Loopback is always trusted.
Hosting__TrustedProxies__0=
Hosting__TrustedNetworks__0=10.0.0.0/8

# ---------------------------------------------------------------- Database (MySQL 8 or SQLite)
# MySql (default; multi-instance capable) | Sqlite (single API instance; database is a file on a persistent disk).
Database__Provider=MySql
# MySQL — SECRET (contains the password). Use SslMode=Required (or VerifyFull) against managed MySQL.
# Alternatively set Database__Host / Database__Port / Database__Name / Database__User / Database__Password.
ConnectionStrings__Default=Server=db.internal;Port=3306;Database=optimizeall;User=optimizeall;Password=change-me;SslMode=Required;
# SQLite — path of the database file (directory created if missing; wins over ConnectionStrings__Default, which may
# instead hold a SQLite connection string such as "Data Source=/app/storage/db/optimizeall.db"). The Data Protection
# key ring is kept next to it (optimizeall-keys/). Back up the db, -wal and keys together. Run exactly ONE API instance.
# Database__Provider=Sqlite
# Database__SqlitePath=/app/storage/db/optimizeall.db
# Migrate (apply EF migrations at startup) | EnsureCreated (throwaway local DBs only) | None (schema managed
# by the migration bundle job — recommended for production).
Database__InitializationMode=Migrate
# Run initialization (migrations per mode + bootstrap admin + seed profiles) when the API starts.
Database__InitializeOnStartup=true
# Seed profiles, applied in order, idempotent. Baseline = reference data every environment needs.
# Demo = demo users/campaigns for staging and local development ONLY.
Database__Seed__0=Baseline
# Database__Seed__1=Demo

# ---------------------------------------------------------------- Authentication tokens
# SECRET. HMAC signing key for access tokens; >= 32 random bytes. Rotating it signs everyone out.
Jwt__SigningKey=change-me-generate-with-scripts-generate-secrets-sh
Jwt__Issuer=optimizeall
Jwt__Audience=optimizeall-web
# Access token lifetime (minutes) and refresh token lifetime (days).
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14

# ---------------------------------------------------------------- Security
# SECRET. HMAC key used to hash IP addresses and device ids (raw values are never stored). Keep it stable:
# changing it breaks de-duplication against previously stored hashes.
Security__HashSalt=change-me
# Browser origins allowed by CORS. Leave empty when the SPA and API share an origin (the nginx web image).
# Security__AllowedOrigins__0=https://app.example.com
# Secure flag on the refresh cookie. true everywhere except plain-http local development.
Security__SecureCookies=true

# ---------------------------------------------------------------- Email
# Smtp (required in Production) | File (writes .eml files to PickupDirectory; development/testing).
Email__Mode=Smtp
Email__SmtpHost=smtp.example.com
Email__SmtpPort=587
# STARTTLS on connect. false only for local catchers like Mailpit.
Email__SmtpUseStartTls=true
Email__SmtpUsername=apikey
# SECRET.
Email__SmtpPassword=change-me
Email__FromAddress=no-reply@example.com
Email__FromName=Optimize All
# Public URL of the web app, used to build links in emails (verify email, reset password, campaigns).
Email__AppBaseUrl=https://app.example.com
# File mode only.
Email__PickupDirectory=storage/mail

# ---------------------------------------------------------------- Sign in with Google (optional)
# OAuth 2.0 client (Google Cloud console → APIs & Services → Credentials, type "Web application") with the authorized
# redirect URI {Email__AppBaseUrl}/auth/google/callback. Leave empty to disable (the button is hidden).
Authentication__Google__ClientId=
# SECRET (environment / secret manager / user-secrets only).
Authentication__Google__ClientSecret=
# Optional: only these Google Workspace domains may sign in (hd claim), e.g. example.com.
# Authentication__Google__AllowedHostedDomains__0=example.com
# Optional: override the redirect URI (default {Email__AppBaseUrl}/auth/google/callback).
# Authentication__Google__RedirectUri=

# ---------------------------------------------------------------- File storage
# Directory for uploaded screenshots/files (private; served only through authorized API endpoints).
# Must be persistent, and SHARED between API instances when scaling out. Relative = under the content root.
Storage__RootPath=storage/files

# ---------------------------------------------------------------- WhatsApp Business Cloud API (optional)
WhatsApp__Enabled=false
WhatsApp__PhoneNumberId=
# SECRET. Permanent system-user access token.
WhatsApp__AccessToken=
WhatsApp__ApiBaseUrl=https://graph.facebook.com/v20.0
# Approved message template with two body parameters ({{1}} title, {{2}} body).
WhatsApp__TemplateName=
WhatsApp__TemplateLanguage=en

# ---------------------------------------------------------------- Payments
# Active payout rail. "manual" (default): finance pays outside the platform and records references.
Payments__Provider=manual

# ---------------------------------------------------------------- Tracking & conversions
# Base URL of short tracking links (/t/{code}); defaults to Email__AppBaseUrl.
Tracking__PublicBaseUrl=https://app.example.com
# SECRET. HMAC-SHA256 secret advertisers use to sign conversion postbacks. Share it out-of-band.
Tracking__PostbackSecret=change-me

# ---------------------------------------------------------------- Background jobs
# Master switch for recurring jobs (notification dispatch, campaign schedule, payouts, reminders...).
# Safe with several API instances (DB leases); disable only on instances that must not run jobs.
Jobs__Enabled=true

# ---------------------------------------------------------------- Rate limiting
RateLimiting__Enabled=true
# Credential endpoints (login, register, password reset) per client IP per minute.
RateLimiting__AuthPerMinute=10

# ---------------------------------------------------------------- API documentation & dev tools
# Swagger UI at /api/docs and document at /api/docs/v1/openapi.json. Default: on except in Production.
Swagger__Enabled=false
# Development mailbox endpoint that lists File-mode emails. Never enable in production.
DevTools__MailboxEnabled=false

# ---------------------------------------------------------------- Bootstrap administrator
# When both are set and no user has this email, an administrator is created at startup (email verified).
# Use for the first start only, change the password after signing in, then remove these.
Bootstrap__AdminEmail=
# SECRET.
Bootstrap__AdminPassword=
Bootstrap__AdminDisplayName=Platform Admin

# ---------------------------------------------------------------- Logging
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
# json = one JSON object per line (recommended for log shipping); simple = human readable.
Logging__Console__FormatterName=json

# ---------------------------------------------------------------- Tooling (not read by the API)
# Integration tests: MySql (default) or Sqlite (each test class uses its own temporary SQLite file).
OPTIMIZEALL_TEST_PROVIDER=MySql
# Integration tests: server-level connection string (tests create/drop their own databases).
OPTIMIZEALL_TEST_MYSQL=Server=127.0.0.1;Port=3306;User=optimizeall;Password=optimizeall_dev;
# Integration tests: Migrate (default) or EnsureCreated.
OPTIMIZEALL_TEST_DB_INIT=Migrate
