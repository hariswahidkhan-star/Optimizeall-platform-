# Backend that the Vite dev/preview server proxies /api and /t to.
VITE_API_PROXY_TARGET=http://127.0.0.1:5080
# Expose the /design-system route outside development (e.g. staging builds).
VITE_SHOW_DESIGN_SYSTEM=false
# Base URL for Playwright. When empty, Playwright builds the app and serves it with `vite preview` on :5173.
E2E_BASE_URL=
