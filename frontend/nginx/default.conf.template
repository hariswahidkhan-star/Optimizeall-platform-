# Optimize All web server (rendered by the nginx image's envsubst step into /etc/nginx/conf.d/default.conf).
#
#   ${API_UPSTREAM}   API base URL, e.g. http://api:8080  (only defined env vars are substituted)
#   ${IMG_SRC_EXTRA}  extra CSP img-src sources, space separated, e.g. "https://images.example.com"; must list the
#                     same hosts as the API's Content:AllowedImageHosts (default empty: uploaded images only)
#   ${MEDIA_SRC_EXTRA} extra CSP media-src sources for lesson videos hosted elsewhere (e.g. a HeyGen or CDN host),
#                     space separated (default empty: uploaded videos and captions only)
#
# Serves the Vite SPA and reverse-proxies the API on the same origin:
#   /api/     REST API (+ Swagger UI at /api/docs when enabled on the API)
#   /t/       public tracking redirects (/t/{code})
#   /health/  API liveness/readiness
#   /healthz  this nginx container's own health

# Preserve the original scheme when TLS terminates at an outer load balancer that sets X-Forwarded-Proto;
# otherwise use the scheme of the connection nginx received. Only expose this nginx behind a trusted LB or
# directly to clients (in which case a spoofed header can at most mislabel the scheme of a plain-http request).
map $http_x_forwarded_proto $oa_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# Extra image hosts for the CSP img-src (used in snippets/security-headers.conf, which is not templated).
map "" $oa_img_src_extra {
    default "${IMG_SRC_EXTRA}";
}

# Extra media hosts for the CSP media-src (lesson videos, docs/LEARNING.md).
map "" $oa_media_src_extra {
    default "${MEDIA_SRC_EXTRA}";
}

server {
    # IPv4 only: a hard IPv6 listen fails to start on hosts/runtimes without IPv6.
    listen       8080;
    server_name  _;

    server_tokens off;
    root  /usr/share/nginx/html;
    index index.html;

    # The API enforces per-endpoint limits (screenshots 10 MB, deliverable files up to 50 MB); nginx only caps the
    # largest request so deliverable uploads can reach the API.
    client_max_body_size 55m;

    gzip              on;
    gzip_vary         on;
    gzip_proxied      any;
    gzip_comp_level   5;
    gzip_min_length   1024;
    gzip_types        text/plain text/css text/csv application/javascript application/json application/problem+json
                      application/xml image/svg+xml application/manifest+json font/ttf font/otf;

    # ---------------------------------------------------------------- API (same origin)
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        include /etc/nginx/snippets/proxy-api.conf;
        # CSV exports and batch operations can take longer than the default.
        proxy_read_timeout 120s;
    }

    location /t/ {
        proxy_pass ${API_UPSTREAM};
        include /etc/nginx/snippets/proxy-api.conf;
    }

    # Email tracking: open pixel, click redirect and one-click unsubscribe (RFC 8058). Never cached.
    location /e/ {
        proxy_pass ${API_UPSTREAM};
        include /etc/nginx/snippets/proxy-api.conf;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
    }

    location /health/ {
        proxy_pass ${API_UPSTREAM};
        include /etc/nginx/snippets/proxy-api.conf;
        access_log off;
    }

    # Agency website SEO files are generated by the API from published content (docs/WEBSITE.md).
    location = /robots.txt {
        proxy_pass ${API_UPSTREAM};
        include /etc/nginx/snippets/proxy-api.conf;
    }

    location = /sitemap.xml {
        proxy_pass ${API_UPSTREAM}/api/v1/public/sitemap.xml;
        include /etc/nginx/snippets/proxy-api.conf;
    }

    # Certificate verification pages (Learning) are server-rendered by the API: a complete HTML page with Open Graph /
    # Twitter tags and JSON-LD, so LinkedIn previews and crawlers see the holder, course and status (docs/LEARNING.md).
    location ~ "^/verify/certificates/[0-9a-fA-F-]{36}/?$" {
        rewrite "^/verify/certificates/([0-9a-fA-F-]{36})/?$" /api/v1/public/learning/certificates/$1/page break;
        proxy_pass ${API_UPSTREAM};
        include /etc/nginx/snippets/proxy-api.conf;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # ---------------------------------------------------------------- SPA
    # Vite emits content-hashed files under /assets/: cache forever, never fall back to index.html.
    location /assets/ {
        # Source maps are never served: the build does not emit them, and this also covers a build that did.
        location ~* \.map$ {
            access_log off;
            return 404;
        }
        try_files $uri =404;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        access_log off;
    }

    # The app shell must always be revalidated so new deployments are picked up immediately.
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # Client-side routes fall back to the app shell; other static files (favicon, robots.txt) get a short cache.
    # Before the shell is served, the API's redirect gate is asked whether the address has moved (Website → Redirects,
    # docs/WEBSITE.md): a moved public address gets a real 301 to its new address; anything else (404, or the API being
    # unreachable/slow) serves the shell as before.
    location / {
        try_files $uri @redirect_gate;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=3600" always;
    }

    location @redirect_gate {
        rewrite ^ /api/v1/public/redirects/gate? break;
        proxy_pass ${API_UPSTREAM};
        include /etc/nginx/snippets/proxy-api.conf;
        proxy_set_header X-Original-URI $request_uri;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_read_timeout 5s;
        proxy_intercept_errors on;
        error_page 400 401 403 404 405 429 500 502 503 504 = @app_shell;
    }

    location @app_shell {
        rewrite ^ /index.html last;
    }
}
