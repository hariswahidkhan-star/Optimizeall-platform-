#!/bin/sh
# Sourced by the nginx image entrypoint before templates are rendered (files in /docker-entrypoint.d ending in
# .envsh are sourced in name order, so exports here are visible to 20-envsubst-on-templates.sh).
#
#   API_HOSTPORT   host:port of the API on a private network (e.g. Render's fromService "hostport").
#                  When set, it overrides API_UPSTREAM as http://$API_HOSTPORT.
#   REAL_IP_FROM   space-separated CIDRs of the load balancer in front of nginx (e.g. "10.0.0.0/8" on Render).
#                  nginx then takes the client address from X-Forwarded-For sent by that load balancer, so the
#                  API's rate limits and audit logs see the real client instead of the load balancer.
#   API_WAIT_SECONDS
#                  how long to wait at startup for the API host name to resolve before starting anyway (default 5).
#                  It never blocks startup: nginx starts (and /healthz answers) whether or not the API exists yet.
#   API_RESOLVE_INTERVAL
#                  seconds between checks of the API host name's address (default 10; 0 = only until it first
#                  resolves).
#
# The web container must not depend on the API being up: with `proxy_pass http://<host>:<port>` nginx resolves the
# host once, when it loads its configuration, and refuses to start ("host not found in upstream") while the name does
# not resolve, e.g. while the API service is still being created or is crash-looping. So the API host is not given
# to nginx at all. This script resolves it with the system resolver (resolv.conf search domains included, which
# nginx's own `resolver` would ignore), writes the addresses into an `upstream optimizeall_api` block
# (/etc/nginx/conf.d/00-api-upstream.conf) that the template proxies to (OA_API_PROXY=http://optimizeall_api), and a
# small background loop rewrites that block and reloads nginx whenever the addresses change (API redeployed with a new
# private IP) or first appear. Until then the block holds a placeholder that fails fast: pages answer with the app
# shell and 503 (@document → @shell), /api/ with a JSON 503, and /healthz with 200. Proxied requests keep their exact
# paths, Host header and every other proxy setting: only the address nginx connects to comes from the block.
#
# An API_UPSTREAM that is an IP literal, uses https or has a path is passed to nginx unchanged (OA_API_PROXY).

if [ -n "${API_HOSTPORT:-}" ]; then
  export API_UPSTREAM="http://${API_HOSTPORT}"
fi

if [ -n "${REAL_IP_FROM:-}" ]; then
  {
    for cidr in $REAL_IP_FROM; do
      echo "set_real_ip_from ${cidr};"
    done
    echo "real_ip_header X-Forwarded-For;"
  } > /etc/nginx/conf.d/00-real-ip.conf
fi

oa_upstream_conf=/etc/nginx/conf.d/00-api-upstream.conf
oa_scheme="${API_UPSTREAM%%://*}"
oa_rest="${API_UPSTREAM#*://}"
oa_hostport="${oa_rest%/}"
oa_api_host="${oa_hostport%:*}"
oa_api_port="${oa_hostport##*:}"
[ "$oa_api_port" = "$oa_hostport" ] && oa_api_port=80
case "$oa_hostport" in
  */*|"") oa_api_host="" ;;               # a path: keep proxy_pass as configured
esac
[ "$oa_scheme" = http ] || oa_api_host="" # https needs the host name for SNI/verification
case "$oa_api_host" in
  \[*) oa_api_host="" ;;                   # an IPv6 literal never changes
  *[!0-9.]*) ;;                            # a host name
  *) oa_api_host="" ;;                     # nor does an IPv4 literal
esac
case "$oa_api_port" in
  ""|*[!0-9]*) oa_api_host="" ;;
esac

if [ -z "$oa_api_host" ]; then
  export OA_API_PROXY="$API_UPSTREAM"
  rm -f "$oa_upstream_conf"
else
  export OA_API_PROXY="http://optimizeall_api"
  export OA_API_HOST="$oa_api_host" OA_API_PORT="$oa_api_port" OA_UPSTREAM_CONF="$oa_upstream_conf"

  oa_resolve() { getent ahostsv4 "$OA_API_HOST" 2>/dev/null | awk '{print $1}' | sort -u | tr '\n' ' ' | sed 's/ $//'; }

  # oa_write_upstream "ADDRESSES" — writes the upstream block (atomically: nginx may reload at any moment).
  oa_write_upstream() {
    {
      echo "# Generated by 12-optimizeall-platform.envsh: addresses of $OA_API_HOST (API_UPSTREAM $API_UPSTREAM)."
      echo "upstream optimizeall_api {"
      if [ -n "$1" ]; then
        for oa_ip in $1; do echo "    server $oa_ip:$OA_API_PORT;"; done
      else
        echo "    # $OA_API_HOST does not resolve (yet): fail fast with 502 until it does."
        echo "    server 127.0.0.1:1 down;"
      fi
      echo "}"
    } > "$OA_UPSTREAM_CONF.tmp" && mv -f "$OA_UPSTREAM_CONF.tmp" "$OA_UPSTREAM_CONF"
  }

  # Best effort: give an API that is starting alongside this container a moment to appear, then start regardless.
  oa_waited=0
  oa_addresses="$(oa_resolve)"
  while [ -z "$oa_addresses" ] && [ "$oa_waited" -lt "${API_WAIT_SECONDS:-5}" ]; do
    sleep 1
    oa_waited=$((oa_waited + 1))
    oa_addresses="$(oa_resolve)"
  done
  if [ -z "$oa_addresses" ]; then
    echo "12-optimizeall-platform: the API host $OA_API_HOST does not resolve yet; starting anyway (pages get the app shell with 503 until it does)" >&2
  fi
  oa_write_upstream "$oa_addresses"

  (
    oa_loaded="$oa_addresses"
    oa_interval="${API_RESOLVE_INTERVAL:-10}"
    while :; do
      if [ -z "$oa_loaded" ]; then
        sleep 2                            # not resolved yet: check often
      elif [ "$oa_interval" = 0 ]; then
        exit 0
      else
        sleep "$oa_interval"
      fi
      oa_now="$(oa_resolve)"
      # A failed lookup keeps the last known addresses (DNS hiccup); a changed or first answer reloads nginx. The
      # reload fails while nginx is still starting; the next round then retries it.
      if [ -n "$oa_now" ] && [ "$oa_now" != "$oa_loaded" ]; then
        oa_write_upstream "$oa_now"
        if nginx -s reload 2>/dev/null; then
          echo "12-optimizeall-platform: $OA_API_HOST now resolves to $oa_now (was ${oa_loaded:-unresolved}); reloaded nginx" >&2
          oa_loaded="$oa_now"
        fi
      fi
    done
  ) &
  unset oa_waited oa_addresses
  unset -f oa_resolve oa_write_upstream
fi
unset oa_upstream_conf oa_scheme oa_rest oa_hostport oa_api_host oa_api_port
