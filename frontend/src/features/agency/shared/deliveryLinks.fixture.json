    { "name": "AgencyDeliverable", "path": "/agency/deliverables/:deliverableId" },
    { "name": "AgencyThread", "path": "/agency/clients/:clientId?tab=messages&thread=:threadId" },
    { "name": "AgencyReport", "path": "/agency/reports/:reportId" },
    { "name": "AgencyBrief", "path": "/agency/clients/:clientId?tab=briefs&brief=:briefId" },
    { "name": "AgencyTimesheets", "path": "/agency/time" },
    { "name": "ClientHome", "path": "/client" },
    { "name": "ClientDeliverable", "path": "/client/approvals/:deliverableId?org=:clientId" },
    { "name": "ClientReport", "path": "/client/reports/:reportId?org=:clientId" },
    { "name": "ClientThread", "path": "/client/messages?org=:clientId&thread=:threadId" },
