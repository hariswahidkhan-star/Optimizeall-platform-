# NON-SECRET settings for deploy/docker-compose.production.example.yml.
#   cp deploy/.env.production.example deploy/.env.production
# Secrets do NOT go here: write them to files in SECRETS_DIR (one value per file, chmod 600):
#   db_connection_string      Server=<host>;Port=3306;Database=optimizeall;User=optimizeall;Password=<pw>;SslMode=Required;
#   jwt_signing_key           scripts/generate-secrets.sh --aspnet  (Jwt__SigningKey)
#   hash_salt                 (Security__HashSalt)
#   postback_secret           (Tracking__PostbackSecret)
#   smtp_password             SMTP provider password / API key
#   whatsapp_access_token     WhatsApp Business Cloud API token (empty file if WhatsApp is disabled)
#   bootstrap_admin_password  first-start admin password (empty file afterwards)

# Versioned images (never :latest in production). Build them from the same commit.
API_IMAGE=ghcr.io/your-org/optimizeall-api:1.0.0
MIGRATOR_IMAGE=ghcr.io/your-org/optimizeall-migrator:1.0.0
WEB_IMAGE=ghcr.io/your-org/optimizeall-web:1.0.0

# Public HTTPS origin of the web app (email links) and of tracking links (defaults to the same).
PUBLIC_BASE_URL=https://app.example.com
# TRACKING_BASE_URL=https://go.example.com

# Transactional email provider (SMTP with STARTTLS).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=apikey
EMAIL_FROM_ADDRESS=no-reply@example.com

# WhatsApp Business Cloud API (optional).
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en

# First start only; remove after the administrator has signed in and changed the password.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

SECRETS_DIR=./secrets
# Host path or named volume for uploads (shared storage when running several API instances).
STORAGE_PATH=api-storage
WEB_PORT=8080

# CIDR of the reverse proxy allowed to set X-Forwarded-* headers.
TRUSTED_PROXY_NETWORK=10.0.0.0/8
