# Staging stack settings for deploy/docker-compose.staging.yml.
#   cp deploy/.env.staging.example deploy/.env.staging
#   scripts/generate-secrets.sh --staging >> deploy/.env.staging   # or paste values below
# deploy/.env.staging is git-ignored. Never reuse staging secrets in production.

# ---- Required secrets (replace every "change-me") ----
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_PASSWORD=change-me-app-password
# >= 32 random bytes (base64). Signs access tokens.
JWT_SIGNING_KEY=change-me-use-scripts-generate-secrets-sh-0123456789
# HMAC key for hashing IP addresses / device ids. Changing it breaks click de-duplication history.
HASH_SALT=change-me-hash-salt
# Shared secret advertisers use to sign conversion postbacks.
POSTBACK_SECRET=change-me-postback-secret
# Initial administrator (created on first start if missing).
BOOTSTRAP_ADMIN_EMAIL=admin@optimizeall.local
BOOTSTRAP_ADMIN_PASSWORD=change-me-Admin-Passw0rd!

# ---- Optional ----
MYSQL_DATABASE=optimizeall
MYSQL_USER=optimizeall
# Public URL users reach the web container at (used in email links and tracking links).
PUBLIC_BASE_URL=http://localhost:8080
WEB_PORT=8080
MAILPIT_UI_PORT=8025
# Set to true when staging is served over HTTPS (refresh cookie gets the Secure flag).
SECURE_COOKIES=false
EMAIL_FROM_ADDRESS=no-reply@staging.optimizeall.local
# Second seed profile. "Demo" loads demo users/campaigns; set to "Baseline" to start empty.
DEMO_SEED=Demo
WHATSAPP_ENABLED=false
# Use prebuilt images instead of building locally (e.g. ghcr.io/<org>/optimizeall-api:<sha>).
# API_IMAGE=optimizeall-api:staging
# WEB_IMAGE=optimizeall-web:staging

# Docker network range of the nginx container (default covers compose bridge networks).
TRUSTED_PROXY_NETWORK=172.16.0.0/12
