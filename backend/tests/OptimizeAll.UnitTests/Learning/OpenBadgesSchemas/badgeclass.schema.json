{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Badges 2.0 BadgeClass",
  "description": "Open Badges 2.0 (IMS Global Final, https://www.imsglobal.org/sites/default/files/Badges/OBv2p0Final/index.html): required properties and value types of the hosted-verification documents, transcribed from the specification's data model tables.",
  "type": "object",
  "required": [
    "@context",
    "type",
    "id",
    "name",
    "description",
    "image",
    "criteria",
    "issuer"
  ],
  "properties": {
    "@context": {
      "const": "https://w3id.org/openbadges/v2"
    },
    "type": {
      "const": "BadgeClass"
    },
    "id": {
      "type": "string",
      "pattern": "^https?://"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "image": {
      "type": "string",
      "pattern": "^https?://"
    },
    "criteria": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^https?://"
        },
        {
          "type": "object",
          "anyOf": [
            {
              "required": [
                "id"
              ]
            },
            {
              "required": [
                "narrative"
              ]
            }
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^https?://"
            },
            "narrative": {
              "type": "string"
            }
          }
        }
      ]
    },
    "issuer": {
      "type": "string",
      "pattern": "^https?://"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "alignment": {
      "type": "array"
    }
  }
}
