<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <UserSecretsId>optimizeall-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.8.2" />
    <PackageReference Include="MailKit" Version="4.18.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="8.0.10" />
    <PackageReference Include="MimeKit" Version="4.18.1" />
    <!-- Certificate PDFs (Learning). MIT licence, pure managed (no native/system packages); fonts are embedded below. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OptimizeAll.Infrastructure\OptimizeAll.Infrastructure.csproj" />
    <ProjectReference Include="..\OptimizeAll.Domain\OptimizeAll.Domain.csproj" />
    <ProjectReference Include="..\OptimizeAll.Infrastructure.Sqlite\OptimizeAll.Infrastructure.Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Editable page copy catalog (kept identical to frontend/src/features/public/site/siteCopy.json). -->
    <EmbeddedResource Include="Modules\Content\Copy\site-copy.json" LogicalName="OptimizeAll.SiteCopy.json" />
    <!-- Learning course packs (every *.json in the catalog folder) and the OFL fonts of the certificate PDF. -->
    <Content Remove="Modules\Learning\Catalog\*.json" />
    <EmbeddedResource Include="Modules\Learning\Catalog\*.json" LogicalName="OptimizeAll.Learning.Catalog.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Modules\Learning\Fonts\*.ttf" LogicalName="OptimizeAll.Learning.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OptimizeAll.IntegrationTests" />
    <InternalsVisibleTo Include="OptimizeAll.UnitTests" />
  </ItemGroup>

</Project>
