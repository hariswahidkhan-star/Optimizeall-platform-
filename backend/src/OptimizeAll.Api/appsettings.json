{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "InitializationMode": "Migrate",
    "InitializeOnStartup": true,
    "Seed": [ "Baseline" ]
  },
  "Jwt": {
    "Issuer": "optimizeall",
    "Audience": "optimizeall-web",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Security": {
    "HashSalt": "",
    "AllowedOrigins": [],
    "SecureCookies": true
  },
  "Email": {
    "Mode": "Smtp",
    "FromAddress": "no-reply@optimizeall.app",
    "FromName": "Optimize All",
    "SmtpPort": 587,
    "SmtpUseStartTls": true,
    "AppBaseUrl": "https://app.optimizeall.app"
  },
  "Storage": {
    "RootPath": "storage/files"
  },
  "Content": {
    "AllowedImageHosts": []
  },
  "Payments": {
    "Provider": "manual"
  },
  "WhatsApp": {
    "Enabled": false
  },
  "Jobs": {
    "Enabled": true
  },
  "RateLimiting": {
    "Enabled": true,
    "AuthPerMinute": 10
  },
  "Swagger": {
    "Enabled": false
  },
  "DevTools": {
    "MailboxEnabled": false,
    "TestLoginEnabled": false
  },
  "Impersonation": {
    "SessionMinutes": 60
  },
  "TestAccounts": {
    "EmailDomain": "test.optimizeall.app"
  }
}
